# ---- Required -------------------------------------------------------------
# Public address of the portal (used in email links and for secure cookies)
DOMAIN=leads.example.com
BASE_URL=https://leads.example.com

# Long random string. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later logs everyone out and makes saved SMTP/API secrets unreadable (re-enter them).
SECRET_KEY=

# Postgres password for the bundled database container
POSTGRES_PASSWORD=

# First admin account, created on first start only (change the password after signing in)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ---- Optional research keys ------------------------------------------------
# Leave EMPTY when research runs on your Claude Pro/Max subscription (token goes in Settings -> Research engine).
# Anthropic API key (console.anthropic.com) - only for the "Anthropic API key" engine.
ANTHROPIC_API_KEY=
# Google Gemini API key (aistudio.google.com) - only for the Gemini engine.
GEMINI_API_KEY=

# ---- Optional -------------------------------------------------------------
# SESSION_HOURS=12
# WORKER_POLL_SECONDS=30
# LOG_LEVEL=INFO
# RESEARCH_USER_AGENT=LeadveraResearchBot/1.0 (+https://example.com)
